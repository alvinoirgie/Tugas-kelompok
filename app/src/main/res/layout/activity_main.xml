<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurant Mas Bambang"
            android:textColor="#2D2D2D"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:paddingTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Temukan makanan favoritmu 🍴"
            android:textColor="#777777"
            android:textSize="16sp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp" />

        <!-- CATEGORY -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menu Hari Ini"
            android:textColor="#2D2D2D"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="14dp" />

        <!-- BURGER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="14dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:gravity="center"
                android:text="🍔"
                android:textSize="48sp"
                android:background="#FFF0D9" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Burger Spesial"
                    android:textColor="#292929"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Beef, cheese &amp; fresh vegetables"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:paddingTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rp25.000"
                    android:textColor="#E85D04"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingTop="7dp" />

                <Button
                    android:id="@+id/btnBurger"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="PESAN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#E85D04" />

            </LinearLayout>

        </LinearLayout>

        <!-- AYAM GEPREK CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="14dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:gravity="center"
                android:text="🍗"
                android:textSize="48sp"
                android:background="#FFE4E1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ayam Geprek"
                    android:textColor="#292929"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crispy chicken &amp; spicy sambal"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:paddingTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rp18.000"
                    android:textColor="#E85D04"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingTop="7dp" />

                <Button
                    android:id="@+id/btnAyam"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="PESAN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#E85D04" />

            </LinearLayout>

        </LinearLayout>

        <!-- MIE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="14dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:gravity="center"
                android:text="🍜"
                android:textSize="48sp"
                android:background="#FFF3CD" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mie Goreng"
                    android:textColor="#292929"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Noodles, egg &amp; fresh vegetables"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:paddingTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rp15.000"
                    android:textColor="#E85D04"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingTop="7dp" />

                <Button
                    android:id="@+id/btnMie"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="PESAN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#E85D04" />

            </LinearLayout>

        </LinearLayout>

        <!-- PIZZA CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:gravity="center"
                android:text="🍕"
                android:textSize="48sp"
                android:background="#E8F5E9" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pizza Special"
                    android:textColor="#292929"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cheese, pepperoni &amp; special sauce"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:paddingTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rp35.000"
                    android:textColor="#E85D04"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingTop="7dp" />

                <Button
                    android:id="@+id/btnPizza"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="PESAN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#E85D04" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
