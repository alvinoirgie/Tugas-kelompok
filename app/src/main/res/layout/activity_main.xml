<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================= HEADER ================= -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Aplikasi"
                    android:textColor="#2D2D2D"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Temukan makanan favoritmu 🍴"
                    android:textColor="#777777"
                    android:textSize="14sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnKeranjang"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="#FFF0D9"
                android:contentDescription="Keranjang"
                android:padding="12dp"
                android:src="@drawable/ic_cart" />

        </RelativeLayout>


        <!-- ================= JUDUL MENU ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:text="Menu 🍽️"
            android:textColor="#2D2D2D"
            android:textSize="24sp"
            android:textStyle="bold" />


        <!-- ================= BURGER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="15dp">

            <TextView
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:background="#FFF0D9"
                android:gravity="center"
                android:text="🍔"
                android:textSize="42sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Burger Spesial"
                    android:textColor="#2D2D2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Beef, cheese &amp; fresh vegetables"
                    android:textColor="#777777"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Rp25.000"
                    android:textColor="#E85D04"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnKurangBurger"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:backgroundTint="#EEEEEE"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="-"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvJumlahBurger"
                        android:layout_width="40dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#2D2D2D"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnBurger"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:backgroundTint="#E85D04"
                        android:minWidth="0dp"
                        android:text="PESAN"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ================= AYAM GEPREK ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="15dp">

            <TextView
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:background="#FFF0D9"
                android:gravity="center"
                android:text="🍗"
                android:textSize="42sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ayam Geprek"
                    android:textColor="#2D2D2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Crispy chicken &amp; spicy sambal"
                    android:textColor="#777777"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Rp18.000"
                    android:textColor="#E85D04"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnKurangAyam"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:backgroundTint="#EEEEEE"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="-"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvJumlahAyam"
                        android:layout_width="40dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#2D2D2D"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAyam"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:backgroundTint="#E85D04"
                        android:minWidth="0dp"
                        android:text="PESAN"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ================= MIE GORENG ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="15dp">

            <TextView
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:background="#FFF0D9"
                android:gravity="center"
                android:text="🍜"
                android:textSize="42sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mie Goreng"
                    android:textColor="#2D2D2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Noodles, egg &amp; fresh vegetables"
                    android:textColor="#777777"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Rp15.000"
                    android:textColor="#E85D04"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnKurangMie"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:backgroundTint="#EEEEEE"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="-"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvJumlahMie"
                        android:layout_width="40dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#2D2D2D"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnMie"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:backgroundTint="#E85D04"
                        android:minWidth="0dp"
                        android:text="PESAN"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ================= PIZZA ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="15dp">

            <TextView
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:background="#FFF0D9"
                android:gravity="center"
                android:text="🍕"
                android:textSize="42sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pizza Special"
                    android:textColor="#2D2D2D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cheese, pepperoni &amp; special sauce"
                    android:textColor="#777777"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Rp45.000"
                    android:textColor="#E85D04"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnKurangPizza"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:backgroundTint="#EEEEEE"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="-"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvJumlahPizza"
                        android:layout_width="40dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#2D2D2D"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPizza"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:backgroundTint="#E85D04"
                        android:minWidth="0dp"
                        android:text="PESAN"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>

